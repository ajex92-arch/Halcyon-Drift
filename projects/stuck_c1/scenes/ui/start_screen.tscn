[node name="Tagline" type="Label" parent="Scroll/Center/Card/Col"]
layout_mode = 2
theme_type_variation = &"AmberText"
theme_override_font_sizes/font_size = 13
text = "13 VS 13 · THREE LANES · THE HALCYON DRIFT ASTEROID BELT"

[node name="Title" type="Label" parent="Scroll/Center/Card/Col"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "Halcyon Drift"

[node name="Rules" type="Label" parent="Scroll/Center/Card/Col"]
layout_mode = 2
theme_type_variation = &"MistText"
text = "Two motherships face each other across three lanes joined by a crossing down the middle. Every 35 seconds each mothership launches a wave of minions down every lane. Turrets built by each side's Admiral guard the asteroid resource nodes; between the lanes, a dense asteroid jungle that only strike craft can enter hides derelict monsters worth credits. Each side has 12 pilots and 1 Admiral. The match ends only when a mothership is destroyed."
autowrap_mode = 3

[node name="SeatHeading" type="Label" parent="Scroll/Center/Card/Col"]
layout_mode = 2
theme_type_variation = &"MistText"
theme_override_font_sizes/font_size = 12
text = "CHOOSE YOUR SEAT. THIS CHOICE IS LOCKED FOR THE WHOLE MATCH."

[node name="Seats" type="HBoxContainer" parent="Scroll/Center/Card/Col"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 14

[node name="Admiral" type="PanelContainer" parent="Scroll/Center/Card/Col/Seats"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 0
theme_type_variation = &"SeatLook"

[node name="Col" type="VBoxContainer" parent="Scroll/Center/Card/Col/Seats/Admiral"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Scroll/Center/Card/Col/Seats/Admiral/Col"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Command as Admiral"

[node name="Body" type="Label" parent="Scroll/Center/Card/Col/Seats/Admiral/Col"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"MistText"
theme_override_font_sizes/font_size = 14
text = "Spend the team treasury: mining drones, turrets at resource nodes, mobile repair bays, wards, the Homeworld-style research tree and mothership upgrades. Place waypoints, move the mothership after 20:00 and, late on, command the minions directly. Your camera can go anywhere, and you can launch a ship of your own. 12 AI pilots fly for you."
autowrap_mode = 3

[node name="Pick" type="Button" parent="Scroll/Center/Card/Col/Seats/Admiral/Col"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
focus_mode = 0
mouse_filter = 0
theme_type_variation = &"PrimaryButton"
text = "Command as Admiral"

[node name="Pilot" type="PanelContainer" parent="Scroll/Center/Card/Col/Seats"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 0
theme_type_variation = &"SeatLook"

[node name="Col" type="VBoxContainer" parent="Scroll/Center/Card/Col/Seats/Pilot"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Scroll/Center/Card/Col/Seats/Pilot/Col"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Fly as a Pilot"

[node name="Body" type="Label" parent="Scroll/Center/Card/Col/Seats/Pilot/Col"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"MistText"
theme_override_font_sizes/font_size = 14
text = "Buy a ship, modules and pilot gear with your own credits; earn them from minion last hits, kills, assists, jungle derelicts and your share of every ore delivery. Hold your lane, push turrets with your minion waves and help break the enemy mothership. An AI Admiral commands Aurelian."
autowrap_mode = 3

[node name="Pick" type="Button" parent="Scroll/Center/Card/Col/Seats/Pilot/Col"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
focus_mode = 0
mouse_filter = 0
theme_type_variation = &"PrimaryButton"
text = "Fly as a Pilot"

[node name="ControlsHeading" type="Label" parent="Scroll/Center/Card/Col"]
layout_mode = 2
theme_type_variation = &"MistText"
theme_override_font_sizes/font_size = 12
text = "CONTROLS"

[node name="Controls" type="Label" parent="Scroll/Center/Card/Col"]
layout_mode = 2
theme_type_variation = &"MistText"
theme_override_font_sizes/font_size = 13
text = "Mouse aims (the ship turns to face it). W thrust · S brake · A / D slide sideways · Shift boost · click fire · right-click or G ability · Ctrl hold heading (big ships keep their shields facing a threat while turrets track the mouse) · arrow keys focus shields · 1-4 route energy · R repair kit · F dock · B hangar · Tab board · Space center the camera on your ship (hold to follow it) · screen edge or middle-drag move the camera · H help."
autowrap_mode = 3
